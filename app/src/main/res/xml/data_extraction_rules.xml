<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상의 클라우드 백업과 기기 이전 규칙. 세션 토큰 저장소는 어느 쪽에도 넣지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/picko_session_datastore.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/picko_session_datastore.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
