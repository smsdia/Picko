<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 카카오 지도 인증과 타일 로드 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 픽업 요청의 탑승자 이름으로 연락처 번호를 찾는다. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 차량 위치(FusedLocation SDK)로 픽업 경로의 출발지를 정한다. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- 음성 인식(SpeechToText SDK)으로 픽업 요청을 듣는다. -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- 음성 안내(TextToSpeech SDK)로 결과를 소리로 알린다. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 차량 내비(NaviHelper)에 소요 시간을 묻고(NAVI_ROUTE) 경로 탐색과 안내를 요청한다(NAVI_ROUTE_SEARCH). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".PickoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Picko">
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Picko"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중에도 쓰는 앱이다. 없으면 차량이 주행 상태일 때 "주행 중에는 사용할 수 없습니다."로 막힌다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Gleo 가 schema.json 의 REQUEST_PICKUP 을 호출할 때 받는다. action 은 패키지명이 붙은 형태로 온다. -->
            <intent-filter>
                <action android:name="com.offcourse.picko.REQUEST_PICKUP" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>